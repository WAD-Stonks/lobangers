# Broke O'Clock configuration inventory: NEVER put real credentials in this file.
# Local defaults are below; this inventory also includes unused and reserved settings.
# Production runtime values live in the API project's Vercel environment settings.
# The web needs no required environment variables; its optional browser basemap key is below.
# Do not copy every inventory entry into Vercel.
# Existing GitHub production settings are retained; no GitHub-to-Vercel secret sync is planned.
# See README.md for local setup and optional-service requirements; apps/api/src/config.ts parses runtime values.
# Existing .env files are NOT overwritten by pnpm run setup; add new keys manually.
# Environment entry does not authorize deployment, schema application or feature activation.

# CURRENT API + database runtime (server only)
NODE_ENV=development
# Local listener only; do not add PORT to the Vercel production environment.
PORT=3000
DATABASE_URL=mongodb://127.0.0.1:27017/broke_oclock?replicaSet=rs0&directConnection=true
# pnpm run setup generates a random local secret here; keep production's secret stable.
BETTER_AUTH_SECRET=
WEB_ORIGIN=http://localhost:5173
# Public auth origin. Production web /api proxy design uses the web HTTPS origin.
BETTER_AUTH_URL=http://localhost:3000

# Optional native Google sign-in (server only); both credentials are required to enable it.
# Configure the Web OAuth client's callback at BETTER_AUTH_URL/api/auth/callback/google.
GOOGLE_CLIENT_ID=UNSET
GOOGLE_CLIENT_SECRET=UNSET

# Optional live Makan Squad rooms via Pusher Channels (server only; set all four or none).
# Without them rooms still work by polling. The key and cluster are public; the secret is not.
# Leave "client events" off in Pusher; browsers only listen on private channels.
PUSHER_APP_ID=UNSET
PUSHER_KEY=UNSET
PUSHER_SECRET=UNSET
PUSHER_CLUSTER=UNSET

# RETAINED deployment-job inventory; no deployment workflow or current CI consumer.
# These entries are not required in either Vercel application's runtime environment.
# Deployment-only secret: never forward this token into the app runtime/browser.
VERCEL_TOKEN=UNSET
# Non-secret deployment identifiers. Both projects use the same team.
VERCEL_ORG_ID=UNCONFIGURED
VERCEL_API_PROJECT_ID=UNCONFIGURED
VERCEL_WEB_PROJECT_ID=UNCONFIGURED
# Legacy API-origin reference; the web uses its checked-in Vercel rewrite instead.
API_ORIGIN=http://localhost:3000

# OneMap address search (server only; credentials are optional until lookup is enabled).
# The API uses the registered OneMap account email/password to renew an expiring token.
# Use the OneMap account password, NOT an unrelated email mailbox password.
ONEMAP_EMAIL=UNSET
ONEMAP_EMAIL_PASSWORD=UNSET
# The adapter uses the official fixed host; this legacy value is not an arbitrary URL override.
ONEMAP_BASE_URL=https://www.onemap.gov.sg

# Ingestion: leave enablement and publisher reuse flags false until reuse is cleared and setup is reviewed.
# MoneyDigest uses a fixed public WordPress REST endpoint; no publisher credentials needed.
INGESTION_ENABLED=false
MONEYDIGEST_REUSE_APPROVED=false
SCOOBIFY_REUSE_APPROVED=false
# Legacy references only, not runtime source configuration. Register Telegram preview URLs
# in the admin source registry, which stores them in ImportSource rather than environment values.
SCOOBIFY_POSTS_URL=https://public-api.wordpress.com/wp/v2/sites/scoobifydaily.com/posts
TELEGRAM_PREVIEW_URL=https://t.me/s/thiscounted
# Daily Vercel Cron authentication: server-only, 32-256 ASCII letters/digits/_/-.
# Vercel sends Authorization: Bearer <CRON_SECRET> to the API's scheduled GET.
# Keep unset until an approved production deployment and scheduler activation.
CRON_SECRET=UNSET
# API build output declares one daily job (00:00 UTC, 08:00-08:59 Singapore on Hobby).
# No GitHub scheduler credentials or external workflow are needed.

# CURRENT community verification policy: minimum positive voters, positive percentage and rolling hours.
DEAL_CONFIRM_THRESHOLD=3
DEAL_POSITIVE_PERCENT=80
DEAL_VOTE_WINDOW_HOURS=24
# Reserved report thresholds; these two names are not currently read by application code.
DEAL_DEAD_REPORT_THRESHOLD=UNCONFIGURED
CONTENT_REPORT_THRESHOLD=UNCONFIGURED

# PHOTO STORAGE: user submissions require a photo; merchant photos also use this service.
# Upload callbacks persist photo ownership; add a real server token to enable uploads.
PHOTO_STORAGE_PROVIDER=uploadthing
# Server-only SDK token from the UploadThing app dashboard; never VITE_* or public.
UPLOADTHING_TOKEN=UNSET

# WEB: the same-origin auth, REST and upload clients need no VITE_* variables.
# Optional CARTO basemap key for the browse map. It is a PUBLISHABLE browser key: restrict it to
# your domains in the CARTO dashboard. Leave UNSET to fall back to keyless OneMap tiles.
VITE_CARTO_API_KEY=UNSET
# Optional Lobbie providers (server only). Configure either key; auto mode tries Gemini then Groq.
GEMINI_API_KEY=UNSET
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=UNSET
GROQ_MODEL=openai/gpt-oss-20b
# Optional native email-OTP sign-in and password recovery (server only).
# The API passes this pair to the Resend transport; missing or placeholder values disable these methods.
# A configured pair does not prove verified-domain setup, provider acceptance or inbox delivery.
RESEND_API_KEY=UNSET
# Use a sender on your verified Resend domain; never a browser VITE_* value.
EMAIL_FROM=UNCONFIGURED
