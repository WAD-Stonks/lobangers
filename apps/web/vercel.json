{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://broke-oclock-api.vercel.app/api/:path*"
    },
    {
      "source": "/deals/:dealId",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|TelegramBot|facebookexternalhit|Facebot|Twitterbot|Slackbot|Discordbot|LinkedInBot|SkypeUriPreview|Applebot|Pinterestbot|redditbot|Embedly|Viber|Snapchat|Googlebot|bingbot).*"
        }
      ],
      "destination": "https://broke-oclock-api.vercel.app/api/share/deals/:dealId"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "pnpm run build"
}
